// dnp.rc — embed payload JS files as RT_RCDATA, plus version info.
#include "resource.h"
#include <windows.h>

IDR_DNP_LOADER     RCDATA  "..\\payload\\dnp_loader.js"
IDR_SHIM_MAIN      RCDATA  "..\\payload\\shim_main.js"
IDR_SHIM_RENDERER  RCDATA  "..\\payload\\shim_renderer.js"
// Optional native runtime. The path resolves to a binary that
// addon/build_addon.bat stages into res/embedded/ prior to rc.exe. When
// the file is absent the rc compile still succeeds but the resource is
// empty and load_resource(IDR_RC_ADDON) returns nullopt at run time.
IDR_RC_ADDON       RCDATA  "embedded\\discord_voice_codec.node"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription",  "Discord screenshare quality tuner"
   VALUE "FileVersion",      "0.2.0.0"
   VALUE "InternalName",     "dnp"
   VALUE "OriginalFilename", "dnp.exe"
   VALUE "ProductName",      "DiscordNitroPatcher"
   VALUE "ProductVersion",   "0.2.0.0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
